# Nilai-nilai .env yang PERLU DIUBAH untuk production dengan domain asli +
# Cloudflare Tunnel. Ini bukan file .env lengkap — cuma bagian yang beda
# dari .env lokal kamu. Salin baris yang relevan ke .env di server.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://ptutamacta.com
APP_MAIN_DOMAIN=ptutamacta.com

# PENTING: JANGAN set SESSION_DOMAIN ke ".ptutamacta.com" (wildcard).
# Kalau di-set wildcard, cookie sesi akan ikut terkirim ke SEMUA subdomain
# tenant sekaligus, dan berisiko sesi/login satu tenant "kebawa" ke tenant
# lain lewat browser yang sama. Biarkan SESSION_DOMAIN kosong/null (default)
# supaya cookie login tiap tenant tetap terikat ke subdomain masing-masing.
# SESSION_DOMAIN=null

SESSION_SECURE_COOKIE=true
