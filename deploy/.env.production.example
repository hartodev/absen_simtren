APP_NAME="Smart Absen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ptutamacta.com
APP_MAIN_DOMAIN=ptutamacta.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_simtren
DB_USERNAME=db_simtren_user
DB_PASSWORD=GANTI_PASSWORD_DB

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=.ptutamacta.com
SESSION_SECURE_COOKIE=true

# WAJIB diisi SMTP asli -- tanpa ini, email aktivasi tenant tidak akan terkirim
MAIL_MAILER=smtp
MAIL_HOST=GANTI_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=GANTI_SMTP_USER
MAIL_PASSWORD=GANTI_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@ptutamacta.com"
MAIL_FROM_NAME="${APP_NAME}"
